      "id": "learn",
      "label": "Learn",
      "blocks": [
        {
          "type": "text",
          "title": "What is a map?",
          "md": "A map is a flat picture of a place.\n\n- A **title** tells you what the map shows.\n- A **key** tells you what each symbol means.\n- A **compass rose** shows north, south, east, and west."
        },
        {
          "type": "cards",
          "title": "Words to know",
          "items": [
            {
              "title": "Globe",
              "body": "A round model of the Earth."
            },
            {
              "title": "Equator",
              "body": "An imaginary line around the middle of the Earth."
            },
            {
              "title": "Continent",
              "body": "A very large area of land. The Earth has seven."
            }
          ]
        },
        {
          "type": "callout",
          "title": "Tip:",
          "md": "Find the key first. Then read the map."
        },
        {
